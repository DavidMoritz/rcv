{
  "expo": {
    "name": "Ranked Choices",
    "slug": "ranked-choices",
    "description": "Create and participate in ranked-choice ballots, then view round-by-round results.",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rankedchoices",
    "userInterfaceStyle": "automatic",
    "ios": {
      "buildNumber": "5"
    },
    "android": {
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/46dc0277-6e65-4e0d-ac0e-562113394b3a"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "buildVariant": "development",
      "router": {},
      "eas": {
        "projectId": "46dc0277-6e65-4e0d-ac0e-562113394b3a"
      }
    },
    "owner": "davisomalley"
  }
}
