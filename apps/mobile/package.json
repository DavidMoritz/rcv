{
  "name": "@rankedchoices/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@rankedchoices/rcv-core": "file:../../packages/rcv-core",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "expo": "~57.0.22",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.22",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:android:e2e": "node scripts/android-phase1-e2e.mjs",
    "validate:release": "node scripts/validate-release-readiness.mjs",
    "validate:release:strict": "node scripts/validate-release-readiness.mjs --strict",
    "build:ios": "eas build --profile production --platform ios --local --non-interactive && mkdir -p builds && mv \"$(ls -t build-*.ipa 2>/dev/null | head -1)\" builds/",
    "build:android": "eas build --profile production --platform android --non-interactive",
    "submit:ios": "eas submit --platform ios --non-interactive --path \"$(ls -t builds/build-*.ipa 2>/dev/null | head -1)\""
  },
  "private": true
}
